# ═══════════════════════════════════════════════════
#  Astra AI 后端配置
#  复制为 apps/api/.env 并填入实际值
# ═══════════════════════════════════════════════════

# ── 数据库 ──
# SQLite 文件路径（相对于启动目录或绝对路径）
# ASTRA_DATABASE_URL=sqlite:///./data/astra.db

# ── LLM 对话/审议模型 ──
# 主要对话模型配置（OpenAI 兼容 API），Host Agent 和各 Agent 角色默认使用
ASTRA_LLM_BASE_URL=https://api.deepseek.com/v1
ASTRA_LLM_API_KEY=sk-your-deepseek-key
ASTRA_LLM_MODEL=deepseek-chat
# ASTRA_LLM_TIMEOUT=60

# ── 多模型路由（可选） ──
# JSON 格式定义模型花名册，每个 profile 含 model/base_url/api_key（后者可选，未指定时继承全局配置）
# ASTRA_LLM_MODEL_PROFILES={"default":{"model":"deepseek-chat"},"strong":{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1"}}
# 按阶段指定模型：{"debate":"strong","judge_and_summarize":"strong"}
# ASTRA_LLM_STAGE_ROUTING={}
# 按角色指定模型（优先级高于阶段）：{"host":"strong"}
# ASTRA_LLM_ROLE_ROUTING={}

# ── Embedding 语义搜索 ──
# 独立于对话模型；未配置时 embedding 调用不可用，知识库降级为关键词搜索
# 阿里百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱：https://open.bigmodel.cn/api/paas/v4
ASTRA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASTRA_EMBEDDING_API_KEY=sk-your-aliyun-key
ASTRA_EMBEDDING_MODEL=text-embedding-v3

# ── 鉴权 ──
# JWT Token 签名密钥（生产环境必须设置唯一随机值）
# 可运行: python -c "import secrets; print(secrets.token_urlsafe(32))"
ASTRA_JWT_SECRET=change-me-to-a-random-secret
# API Key fallback（可选；未设置时仅 JWT 鉴权生效）
# ASTRA_API_KEY=
# admin 用户密码（可选；未设置时 admin 不能登录，仅用作 API Key fallback 身份）
# ASTRA_ADMIN_PASSWORD=

# ── CORS ──
# 逗号分隔的允许来源；为空时允许所有来源（开发环境）
# ASTRA_CORS_ORIGINS=https://astra.wlait.com,http://localhost:5173

# ── 速率限制 ──
# ASTRA_RATE_LIMIT_ENABLED=true

# ── SSE 事件流 ──
# 事件轮询间隔（秒），影响工作台实时性
# ASTRA_EVENT_POLL_INTERVAL_SECONDS=0.5

# ── Host Agent 安全边界 ──
# 最大研讨迭代次数（防止无限循环）
# ASTRA_ORCHESTRATION_MAX_ITERATIONS=20
# 连续无进展轮次上限（触发强制终止）
# ASTRA_ORCHESTRATION_NO_PROGRESS_LIMIT=3
# 研讨总超时（秒）
# ASTRA_ORCHESTRATION_TIMEOUT_SECONDS=600
